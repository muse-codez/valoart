---
import Navbar from "../components/Navbar.jsx";
import Footer from "../components/Footer.jsx";
const { title = "ValoArt: Valorant Chat ASCII Arts", description = "ValoArt. Valorant chat ASCII arts, made for VALORANT chat.", active = "" } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" />
  <script src="https://stats.zruvix.com/api/script.js?siteId=8401d27cdb81" defer></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400&family=Noto+Sans+Mono:wght@400&family=Outfit:wght@600;700&family=Yarndings+12&display=swap" rel="stylesheet" />
  <style>
    /* Global website background */
    html, body { background: #343434; }
    body { margin: 0; color: #ece8e1; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
    /* Universal navbar clearance: the navbar is fixed at top 16px and
       ~64px tall on desktop (~110px tall when it wraps on mobile), so
       every page gets this top offset in the shared layout — otherwise
       the first heading on a page (e.g. "Spread ValoArt" on /arts, which
       has no hero/page-header padding of its own) sits underneath it.
       Per-page top paddings below are now small, on top of this offset,
       so no page gets double padding. */
    .wrap { max-width: 1080px; margin: 0 auto; padding: 110px 20px 0; }
    .page-header { padding: 30px 0 20px; }
    .page-header h1 {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(36px, 6vw, 56px);
      line-height: 1.05;
      margin: 0 0 12px;
    }
    .page-header p {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(16px, 2.5vw, 19px);
      line-height: 1.6;
      color: #d8dde2;
      max-width: 680px;
      margin: 0;
    }
    @media (max-width: 600px) {
      /* Navbar wraps to two rows on mobile, so it is taller — give more clearance here, not per-page. */
      .wrap { padding-top: 150px; }
      .page-header { padding-top: 20px; }
    }
  </style>
</head>
<body>
  <Navbar client:load active={active} />
  <main class="wrap">
    <slot />
  </main>
  <Footer />
</body>
</html>
