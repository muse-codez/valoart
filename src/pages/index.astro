---
import Navbar from "../components/Navbar.jsx";
import ArtGallery from "../components/ArtGallery.jsx";
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ValoArt — Valorant Chat ASCII Arts</title>
  <meta name="description" content="ValoArt — Valorant chat ASCII arts, made for VALORANT chat." />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400&family=Outfit:wght@600;700&family=Yarndings+12&display=swap" rel="stylesheet" />
  <style>
    /* Global website background */
    html, body { background: #343434; }
    body { margin: 0; color: #ece8e1; font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
    .hero {
      padding: 170px 0 80px;
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-block;
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ff8a93;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 7px 14px;
      margin: 0 0 22px;
    }
    .hero-title {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.02;
      letter-spacing: -1px;
      margin: 0 0 20px;
    }
    .hero-title span { color: #ff4655; }
    .hero-subtitle {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(17px, 2.5vw, 21px);
      line-height: 1.6;
      color: #d8dde2;
      max-width: 680px;
      margin: 0 auto;
    }
    .anchor { scroll-margin-top: 110px; }
    /* Gallery — screenshot layout, our colours (#343434, #ece8e1, #ff4655) */
    .gallery-section { padding: 20px 0 80px; }
    .gallery-section h2 {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(28px, 4vw, 40px);
      margin: 0 0 8px;
    }
    .gallery-section .lead {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      color: #d8dde2;
      margin: 0 0 18px;
    }
    .gallery-section .meta {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #b9bfc7;
      font-size: 14px;
    }
    .gallery-section .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-top: 16px;
    }
    .gallery-section .card {
      background: #2e2e2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 12px;
      overflow: hidden;
    }
    .gallery-section .preview {
      position: relative;
      background: #242424;
      border-radius: 12px;
      min-height: 170px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      margin-bottom: 14px;
    }
    .gallery-section .heart {
      position: absolute;
      top: 10px;
      right: 10px;
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 4px;
    }
    .gallery-section .preview-link {
      text-decoration: none;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .gallery-section .preview-summary {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #d8dde2;
      font-size: 15px;
    }
    .gallery-section .preview-action {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #ff8a93;
      font-size: 13px;
    }
    .gallery-section .art-card h3 {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 600;
      margin: 0 0 4px;
      font-size: 18px;
      padding: 0 4px;
    }
    .gallery-section .art-card .meta { padding: 0 4px; margin: 0 0 12px; }
    .gallery-section .copy-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.10);
      color: #ece8e1;
      text-decoration: none;
      border-radius: 10px;
      padding: 12px;
      font-size: 14px;
      font-weight: 700;
      font-family: 'Figtree', system-ui, sans-serif;
    }
    .gallery-section .copy-button:hover { background: #ff4655; color: #fff; }
    .gallery-section .gallery-note { margin-top: 18px; }
    @media (max-width: 900px) {
      .gallery-section .grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 600px) {
      .hero { padding: 150px 0 60px; }
      .gallery-section .grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="wrap">
    <section class="hero">
      <p class="hero-eyebrow">Valorant Chat ASCII Arts</p>
      <h1 class="hero-title">Chat art made<br />for <span>VALORANT</span> chat.</h1>
      <p class="hero-subtitle">
        ValoArt is a home for Valorant chat ASCII art — text art built to be
        shared in VALORANT chat, in a fixed-width style that keeps its shape
        when you paste it. Funny, cute, text and emoji arts, made for
        ranked mates, aces, clutches and everything in between.
      </p>
    </section>
    <div class="anchor" id="ascii">
      <ArtGallery client:load />
    </div>
  </main>
</body>
</html>
