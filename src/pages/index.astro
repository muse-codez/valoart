---
import Layout from "../layouts/Layout.astro";
import { GALLERY_ARTS } from "../lib/gallery.js";
import { PROMO_ART } from "../lib/promo.js";

// Landing page showcase: marquee only (floating designs removed).
// Marquee: promo + first 11 gallery arts, duplicated for a seamless loop.
const MARQUEE_ARTS = [PROMO_ART, ...GALLERY_ARTS.slice(0, 11)];
---
<Layout title="ValoArt — Valorant Chat ASCII Arts" description="ValoArt — Valorant chat ASCII arts, made for VALORANT chat." active="">
  <section class="hero">
    <p class="hero-eyebrow">Valorant Chat ASCII Arts</p>
    <h1 class="hero-title">Chat art made<br />for <span>VALORANT</span> chat.</h1>
    <p class="hero-subtitle">
      ValoArt is a home for Valorant chat ASCII art — text art built to be
      shared in VALORANT chat, in a fixed-width style that keeps its shape
      when you paste it. Funny, cute, text and emoji arts, made for
      ranked mates, aces, clutches and everything in between.
    </p>
    <div class="hero-ctas">
      <a class="cta primary" href="/arts">Browse Arts</a>
      <a class="cta" href="/textgen">Make a Banner</a>
      <a class="cta" href="/canvas">Paint on Canvas</a>
    </div>
  </section>

  <section class="marquee-section" aria-label="Featured arts">
    <div class="marquee">
      <div class="marquee-track">
        {MARQUEE_ARTS.map((art) => (
          <a class="marquee-card" href="/arts">
            <pre>{art.art}</pre>
            <span>{art.title}</span>
          </a>
        ))}
        {MARQUEE_ARTS.map((art) => (
          <div class="marquee-card" aria-hidden="true">
            <pre>{art.art}</pre>
            <span>{art.title}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase">
    <a class="showcase-card" href="/arts">
      <h3>Arts</h3>
      <p>149 chat arts to search and copy — funny, cute, text and emoji.</p>
      <span>Browse Arts →</span>
    </a>
    <a class="showcase-card" href="/textgen">
      <h3>Text Gen</h3>
      <p>Turn any phrase up to 16 characters into a chunky block-letter banner.</p>
      <span>Make a Banner →</span>
    </a>
    <a class="showcase-card" href="/canvas">
      <h3>Canvas</h3>
      <p>Paint your own art on a 26-column chat canvas, then publish it.</p>
      <span>Paint on Canvas →</span>
    </a>
  </section>

  <style>
    .hero {
      /* Layout already adds 110px navbar clearance, so only 50px here (was 170px before the shared layout). */
      padding: 50px 0 60px;
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-block;
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ff8a93;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 7px 14px;
      margin: 0 0 22px;
    }
    .hero-title {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.02;
      letter-spacing: -1px;
      margin: 0 0 20px;
    }
    .hero-title span { color: #ff4655; }
    .hero-subtitle {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(17px, 2.5vw, 21px);
      line-height: 1.6;
      color: #d8dde2;
      max-width: 680px;
      margin: 0 auto 28px;
    }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .cta {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 700;
      font-size: 16px;
      color: #ece8e1;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 12px 22px;
    }
    .cta.primary { background: #ff4655; border-color: #ff4655; color: #fff; }
    .cta:hover { transform: translateY(-1px); }

    /* Marquee: slow, seamless, pauses on hover */
    .marquee-section { padding: 20px 0 40px; }
    .marquee {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
      mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }
    @keyframes marquee-scroll {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }
    .marquee-track {
      display: flex;
      gap: 16px;
      width: max-content;
      animation: marquee-scroll 45s linear infinite;
    }
    .marquee:hover .marquee-track { animation-play-state: paused; }
    .marquee-card {
      display: block;
      flex-shrink: 0;
      width: 220px;
      background: #2e2e2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 12px;
      text-decoration: none;
      color: #ece8e1;
    }
    .marquee-card pre {
      font-family: 'Noto Sans Mono', monospace;
      font-size: 9px;
      line-height: 1;
      white-space: pre;
      overflow: hidden;
      max-height: 120px;
      margin: 0 0 8px;
    }
    .marquee-card span {
      font-family: 'Figtree', system-ui, sans-serif;
      font-size: 14px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      display: block;
    }

    .showcase {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      padding: 20px 0 80px;
    }
    .showcase-card {
      display: block;
      background: #2e2e2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 20px;
      text-decoration: none;
      color: #ece8e1;
    }
    .showcase-card h3 {
      font-family: 'Outfit', system-ui, sans-serif;
      margin: 0 0 8px;
    }
    .showcase-card p {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #d8dde2;
      line-height: 1.6;
      margin: 0 0 14px;
    }
    .showcase-card span { font-family: 'Figtree', system-ui, sans-serif; font-weight: 700; color: #ff8a93; }

    @media (max-width: 900px) {
      .showcase { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .hero { padding-top: 30px; }
    }
  </style>
</Layout>
