---
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.jsx";
---
<Layout title="ValoArt: Valorant Chat ASCII Arts" description="ValoArt. Valorant chat ASCII arts, made for VALORANT chat." active="">
  <section class="hero">
    <p class="hero-eyebrow">Valorant Chat ASCII Arts</p>
    <h1 class="hero-title">Chat art made<br />for <span>VALORANT</span> chat.</h1>
    <p class="hero-subtitle">
      Browse 149 Valorant chat ASCII arts. Copy one, paste it in
      VALORANT chat, and it keeps its shape. Funny, cute, text and
      emoji arts for ranked mates, aces, and clutches.
    </p>
    <div class="hero-ctas">
      <a class="cta primary" href="/arts">Browse Arts</a>
      <a class="cta" href="/textgen">Make a Banner</a>
      <a class="cta" href="/canvas">Paint on Canvas</a>
    </div>
  </section>

  <Marquee client:load />

  <section class="showcase">
    <a class="showcase-card" href="/arts">
      <h3>Arts</h3>
      <p>149 chat arts to search and copy. Funny, cute, text and emoji.</p>
      <span>Browse Arts →</span>
    </a>
    <a class="showcase-card" href="/textgen">
      <h3>Text Gen</h3>
      <p>Turn any phrase up to 16 characters into a chunky block-letter banner.</p>
      <span>Make a Banner →</span>
    </a>
    <a class="showcase-card" href="/canvas">
      <h3>Canvas</h3>
      <p>Paint your own art on a 26-column chat canvas, then publish it.</p>
      <span>Paint on Canvas →</span>
    </a>
  </section>

  <style>
    .hero {
      /* Layout already adds 110px navbar clearance, so only 50px here (was 170px before the shared layout). */
      padding: 50px 0 60px;
      text-align: center;
    }
    .hero-eyebrow {
      display: inline-block;
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ff8a93;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 7px 14px;
      margin: 0 0 22px;
    }
    .hero-title {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.02;
      letter-spacing: -1px;
      margin: 0 0 20px;
    }
    .hero-title span { color: #ff4655; }
    .hero-subtitle {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(17px, 2.5vw, 21px);
      line-height: 1.6;
      color: #d8dde2;
      max-width: 680px;
      margin: 0 auto 28px;
    }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .cta {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 700;
      font-size: 16px;
      color: #ece8e1;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 12px 22px;
    }
    .cta.primary { background: #ff4655; border-color: #ff4655; color: #fff; }
    .cta:hover { transform: translateY(-1px); }

    .showcase {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      padding: 20px 0 80px;
    }
    .showcase-card {
      display: block;
      background: #2e2e2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 20px;
      text-decoration: none;
      color: #ece8e1;
    }
    .showcase-card h3 {
      font-family: 'Outfit', system-ui, sans-serif;
      margin: 0 0 8px;
    }
    .showcase-card p {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #d8dde2;
      line-height: 1.6;
      margin: 0 0 14px;
    }
    .showcase-card span { font-family: 'Figtree', system-ui, sans-serif; font-weight: 700; color: #ff8a93; }

    @media (max-width: 900px) {
      .showcase { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .hero { padding-top: 30px; }
    }
  </style>
</Layout>
