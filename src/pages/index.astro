---
import Layout from "../layouts/Layout.astro";
import Marquee from "../components/Marquee.jsx";
---
<Layout title="ValoArt: Valorant Chat ASCII Arts" description="ValoArt. Valorant chat ASCII arts, made for VALORANT chat." active="">
  <section class="hero">
    <h1 class="hero-title">Chat art made<br />for <span>VALORANT</span> chat.</h1>
    <p class="hero-subtitle">
      Browse 149 Valorant chat ASCII arts. Copy one, paste it in
      VALORANT chat, and it keeps its shape. Funny, cute, text and
      emoji arts for ranked mates, aces, and clutches.
    </p>
    <div class="hero-ctas">
      <a class="cta primary" href="/arts">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1" /><rect width="7" height="7" x="14" y="3" rx="1" /><rect width="7" height="7" x="14" y="14" rx="1" /><rect width="7" height="7" x="3" y="14" rx="1" /></svg>
        Browse Arts
      </a>
      <a class="cta" href="/textgen">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="4 7 4 4 20 4 20 7" /><line x1="9" x2="15" y1="20" y2="20" /><line x1="12" x2="12" y1="4" y2="20" /></svg>
        Make a Banner
      </a>
      <a class="cta" href="/canvas">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.622 17.897-10.68-2.913" /><path d="M18.376 2.622a1 1 0 1 1 3.002 3.002L17.36 9.643a.5.5 0 0 0 0 .707l.944.944a2.41 2.41 0 0 1 0 3.408l-.944.944a.5.5 0 0 1-.707 0L8.354 7.348a.5.5 0 0 1 0-.707l.944-.944a2.41 2.41 0 0 1 3.408 0l.944.944a.5.5 0 0 0 .707 0z" /><path d="M9 8c-1.804 2.71-3.97 3.46-6.583 3.948a.507.507 0 0 0-.302.819l7.32 8.883a1 1 0 0 0 1.185.204C12.735 20.405 16 16.792 16 15" /></svg>
        Paint on Canvas
      </a>
    </div>
  </section>

  <Marquee client:load />

  <section class="showcase">
    <a class="showcase-card" href="/arts">
      <h3>Arts</h3>
      <p>149 chat arts to search and copy. Funny, cute, text and emoji.</p>
      <span>Browse Arts →</span>
    </a>
    <a class="showcase-card" href="/textgen">
      <h3>Text Gen</h3>
      <p>Turn any phrase up to 16 characters into a chunky block-letter banner.</p>
      <span>Make a Banner →</span>
    </a>
    <a class="showcase-card" href="/canvas">
      <h3>Canvas</h3>
      <p>Paint your own art on a 26-column chat canvas, then publish it.</p>
      <span>Paint on Canvas →</span>
    </a>
  </section>

  <style>
    .hero {
      /* Layout already adds 110px navbar clearance, so only 50px here (was 170px before the shared layout). */
      padding: 50px 0 60px;
      text-align: center;
    }
    .hero-title {
      font-family: 'Outfit', system-ui, sans-serif;
      font-weight: 700;
      font-size: clamp(42px, 7vw, 76px);
      line-height: 1.02;
      letter-spacing: -1px;
      margin: 0 0 20px;
    }
    .hero-title span { color: #ff4655; }
    .hero-subtitle {
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 400;
      font-size: clamp(17px, 2.5vw, 21px);
      line-height: 1.6;
      color: #d8dde2;
      max-width: 680px;
      margin: 0 auto 28px;
    }
    .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: 'Figtree', system-ui, sans-serif;
      font-weight: 700;
      font-size: 16px;
      color: #ece8e1;
      text-decoration: none;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 12px 22px;
    }
    .cta svg { flex-shrink: 0; }
    .cta.primary { background: #ff4655; border-color: #ff4655; color: #fff; }
    .cta:hover { transform: translateY(-1px); }

    .showcase {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      padding: 20px 0 80px;
    }
    .showcase-card {
      display: block;
      background: #2e2e2e;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 20px;
      text-decoration: none;
      color: #ece8e1;
    }
    .showcase-card h3 {
      font-family: 'Outfit', system-ui, sans-serif;
      margin: 0 0 8px;
    }
    .showcase-card p {
      font-family: 'Figtree', system-ui, sans-serif;
      color: #d8dde2;
      line-height: 1.6;
      margin: 0 0 14px;
    }
    .showcase-card span { font-family: 'Figtree', system-ui, sans-serif; font-weight: 700; color: #ff8a93; }

    @media (max-width: 900px) {
      .showcase { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .hero { padding-top: 30px; }
    }
  </style>
</Layout>
